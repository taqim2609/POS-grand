# Salin file ini menjadi backend/.env.docker lalu isi nilainya:
#   cp backend/.env.docker.example backend/.env.docker
# Wajib diubah (jangan dibiarkan "GANTI_DENGAN_ACAK"):
#   JWT_SECRET  -> teks acak panjang (mis. 32+ karakter)
#   ADMIN_EMAIL / ADMIN_PASSWORD -> akun pemilik pertama
MONGO_URL=mongodb://mongo:27017
DB_NAME=grandpos
JWT_SECRET=GANTI_DENGAN_ACAK
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI_DENGAN_ACAK
ADMIN_NAME=Admin

# --- Opsional: AI (deskripsi/foto produk, ringkasan laporan, asisten) ---
# Isi minimal SATU dari kunci berikut agar fitur AI aktif.
# EMERGENT_LLM_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4o-mini

# --- Opsional: notifikasi WhatsApp via wacloud.id ---
# WEBHOOK_CRON_SECRET=

# --- Opsional lainnya ---
# CORS_ORIGINS=*
# VIBE_UPDATE_BASE_URL=https://taqim258.vibecoder.co.id/pos-grand-update   # pusat update (banner versi baru)
